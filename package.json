{
  "name": "@transomjs/transom-core",
  "version": "5.0.1",
  "description": "A low-code REST API framework",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "npm run build && tsc -p tsconfig.json",
    "pretest": "npm run build",
    "deploy": "np",
    "test": "cross-env NODE_ENV=test DEBUG='transom:*' c8 mocha",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/transomjs/transom-core.git"
  },
  "bugs": {
    "url": "https://github.com/transomjs/transom-core/issues"
  },
  "keywords": [
    "express",
    "mongoose",
    "rest",
    "rest api"
  ],
  "author": "BinaryOps Software Inc. <admin@binaryops.ca>",
  "license": "MIT",
  "homepage": "https://github.com/transomjs/transom-core#readme",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/debug": "^4.1.13",
    "@types/node": "^22.20.5",
    "@types/semver": "^7.8.0",
    "@types/serve-favicon": "^2.5.7",
    "c8": "^10.1.3",
    "chai": "^6.2.0",
    "cross-env": "^7.0.3",
    "mocha": "^10.8.2",
    "mocha-lcov-reporter": "^1.3.0",
    "np": "^10.2.0",
    "sinon": "^21.0.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@types/bunyan": "^1.8.11",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "bunyan": "^1.8.15",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "debug": "^4.4.3",
    "express": "^4.21.2",
    "http-errors": "^2.0.0",
    "pocket-registry": "^1.1.8",
    "semver": "^7.7.2",
    "serve-favicon": "^2.5.1"
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist",
