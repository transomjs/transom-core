{
  "all": true,
  "src": [
    "src"
  ],
  "include": [
    "src/**/*.ts",
    "dist/**/*.js"
  ],
  "exclude": [
    "**/*.d.ts"
  ],
  "exclude-after-remap": true,
  "reporter": [
    "text",
    "html",
    "lcov"
  ],
  "check-coverage": true,
  "statements": 100,
  "branches": 100,
  "functions": 100,
  "lines": 100
}
